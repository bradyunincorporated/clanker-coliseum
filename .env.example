# Optional. Leave unset where the environment's network proxy injects the Gemini key
# (x-goog-api-key for generativelanguage.googleapis.com). Bun loads .env on its own.
GEMINI_API_KEY=
# TypeSafe Jev (Bearer) and Cloudflare Clef (Bearer, plus the account that runs Workers AI).
TYPESAFE_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Port of the arena service; the web app proxies /api to it.
ARENA_PORT=8787
